  "info": {
    "_postman_id": "fae02f32-3ad4-41b1-be8c-65abbc6db3ee",
    "name": "Typesense Analytics Analytics Rules API",
    "description": "The Typesense Analytics API allows developers to track and analyze search behavior by recording click, conversion, and visit events. It provides endpoints for creating analytics rules, logging events with metadata tags, and retrieving popular queries and queries with no results. This data can be used to improve search relevance through query suggestions, curations, and understanding user search patterns.\n\nContact Support:\n Name: Typesense Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
