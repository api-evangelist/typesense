{
  "opencollection": "1.0.0",
  "info": {
    "name": "Typesense Analytics Analytics Events Configuration API",
    "version": "30.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-TYPESENSE-API-KEY",
      "value": "{{X-TYPESENSE-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update Server Configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{hostname}:{port}/config",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates server configuration settings such as toggling slow request logging."
        }
      ]
    }
  ],
  "bundled": true
}